<?xml version="1.0"?>
<!--
  teleop_stack.launch.xml - the teleoperation stack itself.

  Not meant to be launched directly. The two entry points
  (teleop_sim.launch.xml and teleop_virtual.launch.xml) include it with the
  hardware choice pinned, so that there is no argument combination which starts
  the wrong thing. The reason for that split is the same one the arm's own
  launch files give: "demonstration" and "real" should be two commands, not one
  command with a flag somebody can get wrong.

  What this starts
  ================
    1. hardware        ros2_control_node with the described hardware, plus the
                       firmware daemon when the hardware is the real protocol
                       over a fake firmware
    2. controllers     joint_state_broadcaster, vr_forward_controller,
                       gripper_controller
    3. robot_state_publisher
    4. rviz2           optional, showing the model and the tf tree
    5. headset_link.py the WebSocket link to the headset
    6. vr_teleop_node  semantics, planning and the command stream

  What it deliberately does NOT start: move_group, and the arm's
  joint_trajectory_controller. Planning happens inside vr_teleop_node, so a
  planner node in this stack would be a second, unused planning entry; and the
  trajectory controller claims the same command interfaces as
  vr_forward_controller, so the two cannot both be active.

  Hardcoded shm_name
  ==================
  The shared memory segment is named separately from the arm stack's default
  (/litearm_hw), so that this stack cannot attach to a segment belonging to a
  running arm stack and drive motors nobody expected to move.-->
<launch>

  <!-- Use the plugin-free mock hardware instead of the real protocol chain. -->
  <arg name="use_mock_hardware" default="false"
       description="true = ros2_control mock_components (no firmware, no daemon, no can0)"/>
  <arg name="shm_name" default="/litearm_vr_hw"
       description="shared memory segment name; kept away from the arm stack's /litearm_hw on purpose"/>
  <arg name="use_rviz" default="true" description="start rviz2"/>
  <arg name="headset_port" default="8765"
       description="WebSocket port the headset connects to"/>
  <arg name="headset_python" default="$(env HOME)/venvs/metavr-arm/bin/python"
       description="interpreter that provides the websockets module; headset_link.py re-executes into it, so the system Python does not need it"/>
  <arg name="arm_description_package"
       default="$(command 'cat $(find-pkg-share litearm_vr_moveit_config)/config/arm_description_package.txt')"
       description="package providing the bare arm description (no ros2_control blocks). Default comes from litearm_vr_moveit_config's build, which detected it: the name differs between workspaces (litearm vs litearm_description) and xacro cannot compose it from a variable"/>
  <arg name="ik_backend" default="plugin"
       description="inverse kinematics backend: plugin (the MoveIt solver named in the configuration) or dls (damped least squares, implemented in this package)"/>
  <arg name="ros_domain_id" default="42" description="ROS domain for this stack"/>
  <arg name="ros_localhost_only" default="1" description="1 = local discovery only"/>

  <!-- Every process in this stack, including the included ones, reads these. A
       terminal that wants to watch the stack has to export the same two values,
       which the banner below spells out. -->
  <set_env name="ROS_DOMAIN_ID" value="$(var ros_domain_id)"/>
  <set_env name="ROS_LOCALHOST_ONLY" value="$(var ros_localhost_only)"/>
  <set_env name="LITEARM_VR_PYTHON" value="$(var headset_python)"/>

  <!-- Robot description, expanded at launch time. The mock hardware choice lives
       in the description rather than in a parameter because a ros2_control
       hardware component IS a piece of the description: the mock branch replaces
       the two real hardware blocks with a single mock one, so the component that
       gets loaded is decided by which file this is. -->
  <!-- The gripper's hardware component is configured through xacro arguments, which
       this launch therefore has to supply. The three below are the ones that decide
       whether it will move at all:

         litegrip_dry_run              true: the component drives a simulated plant
                                       instead of can0. Always true here, because
                                       this stack has no real-hardware launch.
         litegrip_hardware_enable      false: the motor gate. Belt and braces next to
                                       the line above.
         litegrip_max_feedback_velocity_rad_s
                                       The component refuses to send ANY motion frame
                                       when this bound is missing (its default is
                                       deliberately negative, a fail-closed value
                                       that has to be calibrated on real hardware).
                                       With a simulated plant the measured speed is
                                       the commanded rate by construction, so the
                                       command ceiling is a derived value here rather
                                       than an invented one. On real hardware this
                                       number must come from a measurement; that is
                                       why the guard exists and why it is not
                                       defaulted in the description. -->
  <!-- The description path is composed here rather than in the description file,
       because xacro cannot do it: $(find ...) takes a literal and does not
       substitute an argument or a property inside its own parentheses. Both were
       tried. Launch substitutions do nest, which is why the composition lives on
       this side. -->
  <let name="arm_description_xacro"
       value="$(find-pkg-share $(var arm_description_package))/urdf/$(var arm_description_package).urdf"/>
  <let name="urdf"
       value="$(command 'xacro $(find-pkg-share litearm_vr_moveit_config)/urdf/litearm_vr.urdf.xacro use_mock_hardware:=$(var use_mock_hardware) litearm_shm_name:=$(var shm_name) arm_description_xacro:=$(var arm_description_xacro) litegrip_dry_run:=true litegrip_hardware_enable:=false litegrip_max_feedback_velocity_rad_s:=1.5')"/>
  <let name="srdf"
       value="$(command 'xacro $(find-pkg-share litearm_vr_moveit_config)/srdf/litearm_vr.srdf.xacro')"/>
  <let name="teleop_params"
       value="$(find-pkg-share litearm_vr_teleop)/config/vr_teleop.yaml"/>
  <let name="controller_params"
       value="$(find-pkg-share litearm_vr_teleop)/config/vr_controllers.yaml"/>

  <log message="──────── LiteArm VR teleop ────────&#10;  mock hardware: $(var use_mock_hardware)&#10;  arm description: $(var arm_description_package)&#10;  headset: ws://0.0.0.0:$(var headset_port)&#10;  inverse kinematics backend: $(var ik_backend)&#10;  To watch this stack from another terminal, export:&#10;      export ROS_DOMAIN_ID=$(var ros_domain_id) ROS_LOCALHOST_ONLY=$(var ros_localhost_only)&#10;────────────────────────────────────"/>

  <!-- ── 1. hardware ───────────────────────────────────────────────────────── -->

  <!-- The firmware daemon owns the USB CDC link and the shared memory segment and
       hands state to the hardware component. Only present when the hardware is not
       mocked: with mock_components there is no daemon, no segment and no protocol.

       The dry run flag is hardcoded rather than exposed as an argument, so that no
       combination of arguments to this stack can reach a real arm. A real hardware
       launch is one copy of the sim entry point with this flag removed and the
       shared memory name changed back; until such a launch exists, the arm stack's
       own files are the only way to drive the hardware, and that is the intent. -->
  <!-- Started as a plain executable rather than as a node. The daemon is not a ROS
       node: it takes command line arguments and has no idea what ROS arguments mean.
       A node action appends ROS arguments (and a node name remap as soon as a name
       is given), which the daemon's argument parser rejects outright, so it exits
       during argument parsing before it can open anything. The arm's own launch
       starts it the same way, for the same reason. -->
  <executable cmd="$(find-pkg-prefix litearm_ros2_control)/lib/litearm_ros2_control/litearm_hw_daemon --shm-name $(var shm_name) --dry-run"
              output="screen" unless="$(var use_mock_hardware)"/>

  <!-- No name attribute on purpose. Giving this node an explicit name makes launch
       add a __node:= remap to its arguments, and the controller manager passes its
       own node options on to every controller it loads. The controllers' nodes then
       inherit that remap, end up named controller_manager as well, and can no
       longer find their own parameters: the symptom is a controller reporting an
       empty parameter, which reads like a configuration mistake in the controller
       rather than like a naming collision. The executable already defaults to
       controller_manager, which is the name the rest of the system expects. -->
  <!-- Delayed, because the hardware component of the arm opens the shared memory
       segment that the daemon creates, and reports a failure to configure if the
       segment is not there yet. On the machine this was written for the gap is
       about 130 ms and the daemon then spends a while longer reading the firmware's
       parameter table, so two seconds is margin rather than a measurement. Started
       together, the control node loses the race and takes the whole stack down with
       it. The delay is applied in both modes, including the mock one where nothing
       needs it, so that the ordering is a property of the launch file rather than
       of which mode is running. -->
  <timer period="2.0">
    <node pkg="controller_manager" exec="ros2_control_node" output="both">
      <param name="robot_description" type="str" value="$(var urdf)"/>
      <param from="$(var controller_params)"/>
    </node>
  </timer>

  <node pkg="robot_state_publisher" exec="robot_state_publisher" name="robot_state_publisher"
        output="both">
    <param name="robot_description" type="str" value="$(var urdf)"/>
  </node>

  <!-- ── 2. controllers ────────────────────────────────────────────────────── -->
  <!-- One spawner invocation with all three names, not three nodes.
       ros2_control loads and activates them one at a time within a single
       invocation, which is the ordering that matters: parallel spawner processes
       have been observed to collide while loading plugins and parameters. A
       Python launch file could express the same ordering with process exit event
       handlers; XML launch has no such events, so the ordering is expressed by
       putting the names in one list, where it is true by construction.

       The param file option is what puts each controller's own parameters onto its node.
       Loading the same file into the controller manager is NOT enough: the manager
       reads the controller_manager section and ignores the rest, so a controller
       left to find its parameters on its own finds nothing and fails with an empty
       parameter that reads like a configuration mistake in the controller code. -->
  <node pkg="controller_manager" exec="spawner" name="spawner" output="screen"
        args="--param-file $(var controller_params) --controller-manager /controller_manager --controller-manager-timeout 60 joint_state_broadcaster vr_forward_controller gripper_controller"/>

  <!-- ── 3. rviz ───────────────────────────────────────────────────────────── -->
  <node pkg="rviz2" exec="rviz2" name="rviz2" output="log" if="$(var use_rviz)"
        args="-d $(find-pkg-share litearm_vr_moveit_config)/rviz/litearm_vr.rviz">
    <param name="robot_description" type="str" value="$(var urdf)"/>
    <param name="robot_description_semantic" type="str" value="$(var srdf)"/>
  </node>

  <!-- ── 4. the headset link ───────────────────────────────────────────────── -->
  <!-- Installed as a program, so it starts like any other node. It re-executes
       itself into the interpreter named by LITEARM_VR_PYTHON before importing
       websockets, and does so in place, so launch's process handling and SIGINT
       delivery are unaffected. -->
  <node pkg="litearm_vr_teleop" exec="headset_link.py" name="headset_link" output="screen">
    <param from="$(var teleop_params)"/>
    <param name="port" type="int" value="$(var headset_port)"/>
  </node>

  <!-- ── 5. the teleoperation node ─────────────────────────────────────────── -->
  <node pkg="litearm_vr_teleop" exec="vr_teleop_node" name="vr_teleop" output="screen">
    <param from="$(var teleop_params)"/>
      <!-- The TCP the teleop targets; see the file for what the offset means. -->
      <param from="$(find-pkg-share litearm_vr_teleop)/config/tcp.yaml"/>
    <param name="ik_backend" value="$(var ik_backend)"/>
    <param name="robot_description" type="str" value="$(var urdf)"/>
    <!-- The SRDF is what names the planning group, so the kinematic model cannot be
         built without it. Passed as str for the same reason as the URDF: a long
         XML document fed to a node as an inferred type is a YAML parse waiting to
         fail on some future comment containing a colon. -->
    <param name="robot_description_semantic" type="str" value="$(var srdf)"/>
  </node>

</launch>
