<?xml version="1.0"?>
<!--
  teleop_virtual.launch.xml - teleoperation against virtual hardware.

  Nothing here touches a robot, a serial port or a CAN bus. The hardware
  component is ros2_control's mock_components/GenericSystem, which mirrors what
  the controllers write straight back as state. There is no firmware, no
  hardware daemon, no shared memory segment, and no protocol.

  What it is for
  ==============
  Watching the whole teleoperation path end to end, cheaply: the headset link,
  the frame parsing, the grip and trigger edges, the increment mapping, the
  inverse kinematics, the joint filter, the forward controller and the gripper
  controller are all the real ones. Only the last centimetre is replaced.

  What it is NOT for
  ==================
  Anything about timing or dynamics. The mock arm teleports to whatever it is
  commanded, so a position following error, a slew rate or a torque budget cannot
  be observed here. Judging those needs teleop_sim.launch.xml, where the real
  protocol chain runs against a fake firmware.

  Usage:
      ros2 launch litearm_vr_teleop teleop_virtual.launch.xml
      ros2 launch litearm_vr_teleop teleop_virtual.launch.xml use_rviz:=false
      ros2 launch litearm_vr_teleop teleop_virtual.launch.xml ik_backend:=dls

  Connect the headset to ws://<this machine>:8765, then press the grip.-->
<launch>
  <arg name="use_rviz" default="true" description="start rviz2"/>
  <arg name="use_mock_hardware" default="true" description="pinned to mock hardware by this entry point; not meant to be changed"/>
  <arg name="headset_port" default="8765" description="WebSocket port the headset connects to"/>
  <arg name="headset_python" default="$(env HOME)/venvs/metavr-arm/bin/python"
       description="interpreter providing the websockets module"/>
  <arg name="ik_backend" default="plugin" description="plugin or dls"/>
  <!-- The gripper has no arguments here on purpose. The mock hardware block is
       one component covering the arm AND the gripper, so this entry point cannot
       drive a real gripper at any setting: its hardware is simulated along with
       the arm's. Use teleop_sim.launch.xml for a real gripper - it keeps the arm
       fake (the daemon's dry run) while the gripper component is the real one. -->
  <arg name="follow_mode" default="velocity" description="velocity (default) or position"/>
  <!-- Only needed if the build-time detection picked the wrong description package,
       which can happen in a workspace that installs both names. -->
  <arg name="arm_description_package" default="$(command 'cat $(find-pkg-share litearm_vr_moveit_config)/config/arm_description_package.txt')"
       description="package providing the bare arm description; default detected at build time"/>
  <arg name="ros_domain_id" default="42" description="ROS domain for this stack"/>
  <arg name="ros_localhost_only" default="1" description="1 = local discovery only"/>

  <log message="virtual hardware: nothing below this point can move a real arm"/>

  <include file="$(find-pkg-share litearm_vr_teleop)/launch/teleop_stack.launch.xml">
    <arg name="use_mock_hardware" value="$(var use_mock_hardware)"/>
    <arg name="use_rviz" value="$(var use_rviz)"/>
    <arg name="headset_port" value="$(var headset_port)"/>
    <arg name="headset_python" value="$(var headset_python)"/>
    <arg name="ik_backend" value="$(var ik_backend)"/>
    <arg name="follow_mode" value="$(var follow_mode)"/>
    <arg name="arm_description_package" value="$(var arm_description_package)"/>
    <arg name="ros_domain_id" value="$(var ros_domain_id)"/>
    <arg name="ros_localhost_only" value="$(var ros_localhost_only)"/>
  </include>
</launch>
